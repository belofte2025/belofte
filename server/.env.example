# Server Configuration
PORT=10000
NODE_ENV=development

# Database
# For local development, use your local PostgreSQL or Supabase connection string
# For production, use your managed database URL
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT
# IMPORTANT: Generate a secure secret for production!
# Use: openssl rand -base64 32
JWT_SECRET="your_secure_jwt_secret_here_change_in_production"

# Swagger
# Update this to your production URL when deployed
SWAGGER_SERVER_URL="http://localhost:10000/api"