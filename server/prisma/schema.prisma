generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Accounting Enums ──────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalEntryStatus {
  POSTED
  REVERSED
  VOID
}

enum JournalSource {
  SALE
  PURCHASE
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
  EXPENSE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  STOCK_ADJUSTMENT
  TRANSFER
  MANUAL
  PAYROLL
  INVOICE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum WaybillStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum TransferPartyType {
  CUSTOMER
  SUPPLIER
  ACCOUNT
}

// ── Core Models ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  actionType  String
  entityType  String
  entityId    String
  description String
  timestamp   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id])
}

model Company {
  id               String           @id @default(uuid())
  address          String?
  phone            String?
  createdAt        DateTime         @default(now())
  companyName             String
  enableAccounting        Boolean          @default(false)
  notificationsEnabled    Boolean          @default(false)
  notificationChannel     String           @default("SMS")
  Account          Account[]
  Container        Container[]
  Customer         Customer[]
  CustomerDebt     CustomerDebt[]
  CustomerPayment  CustomerPayment[]
  CustomerReturn   CustomerReturn[]
  Expense          Expense[]
  Invoice          Invoice[]
  JournalEntry     JournalEntry[]
  LedgerTransfer   LedgerTransfer[]
  Role             Role[]
  SMSLog           SMSLog[]
  Sale             Sale[]
  StockAdjustment  StockAdjustment[]
  Supplier         Supplier[]
  User             User[]
  Waybill          Waybill[]
}

model Container {
  id            String          @id @default(uuid())
  containerNo   String
  arrivalDate   DateTime
  year          Int
  status        String          @default("Pending")
  supplierId    String
  companyId     String
  createdAt     DateTime        @default(now())
  Company       Company         @relation(fields: [companyId], references: [id])
  Supplier      Supplier        @relation(fields: [supplierId], references: [id])
  ContainerItem ContainerItem[]
}

model ContainerItem {
  id          String    @id @default(uuid())
  containerId String
  itemName    String
  quantity    Int
  receivedQty Int       @default(0)
  unitPrice   Float
  soldQty     Int       @default(0)
  Container   Container @relation(fields: [containerId], references: [id])
}

model Customer {
  id              String           @id @default(uuid())
  phone           String
  balance         Float            @default(0)
  companyId       String
  createdAt       DateTime         @default(now())
  customerName    String
  Company         Company          @relation(fields: [companyId], references: [id])
  CustomerDebt    CustomerDebt[]
  CustomerPayment CustomerPayment[]
  CustomerReturn  CustomerReturn[]
  Invoice         Invoice[]
  SMSLog          SMSLog[]
  Sale            Sale[]
  Waybill         Waybill[]
  DebitTransfers  LedgerTransfer[] @relation("TransferDebitCustomer")
  CreditTransfers LedgerTransfer[] @relation("TransferCreditCustomer")
}

model CustomerDebt {
  id          String   @id @default(uuid())
  customerId  String
  companyId   String
  amount      Float
  description String?
  debtType    String   @default("manual")
  status      String   @default("unpaid")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Company     Company  @relation(fields: [companyId], references: [id])
  Customer    Customer @relation(fields: [customerId], references: [id])
}

model CustomerPayment {
  id            String         @id @default(uuid())
  customerId    String
  companyId     String
  amount        Float
  note          String?
  createdAt     DateTime       @default(now())
  paymentType         String?        @db.VarChar
  depositAccountCode  String?
  Company             Company        @relation(fields: [companyId], references: [id])
  Customer            Customer       @relation(fields: [customerId], references: [id])
  JournalEntries      JournalEntry[]
}

model Permission {
  id             String           @id @default(uuid())
  code           String           @unique
  name           String
  category       String
  description    String?
  RolePermission RolePermission[]
}

model Role {
  id             String           @id @default(uuid())
  name           String
  description    String?
  companyId      String
  isDefault      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  Company        Company          @relation(fields: [companyId], references: [id])
  RolePermission RolePermission[]
  User           User[]

  @@unique([name, companyId])
}

model RolePermission {
  roleId       String
  permissionId String
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  Role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model SMSLog {
  id         String    @id @default(uuid())
  companyId  String
  customerId String?
  recipient  String
  message    String
  status     String
  provider   String
  messageId  String?
  error      String?
  createdAt  DateTime  @default(now())
  Company    Company   @relation(fields: [companyId], references: [id])
  Customer   Customer? @relation(fields: [customerId], references: [id])
}

model Sale {
  id             String         @id @default(uuid())
  saleType       String
  sourceType     String
  sourceId       String
  customerId     String
  companyId      String
  totalAmount    Float
  createdAt      DateTime       @default(now())
  discountType   String?
  discountValue  Float          @default(0)
  subtotal       Float          @default(0)
  Company        Company        @relation(fields: [companyId], references: [id])
  Customer       Customer       @relation(fields: [customerId], references: [id])
  SaleItem       SaleItem[]
  Invoice        Invoice[]
  Waybill        Waybill[]
  JournalEntries JournalEntry[]
  CustomerReturn CustomerReturn[]
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  itemName  String
  quantity  Int
  unitPrice Float
  costPrice Float  @default(0)
  Sale      Sale   @relation(fields: [saleId], references: [id])
}

model StockAdjustment {
  id             String   @id @default(uuid())
  supplierId     String
  itemName       String
  companyId      String
  adjustmentQty  Int
  reason         String?
  adjustmentType String
  notes          String?
  createdBy      String
  createdAt      DateTime @default(now())
  Company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  User           User     @relation(fields: [createdBy], references: [id])
  Supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
  @@index([supplierId, itemName])
}

model Supplier {
  id              String           @id @default(uuid())
  contact         String
  country         String
  companyId       String
  createdAt       DateTime         @default(now())
  suppliername    String
  Container       Container[]
  StockAdjustment StockAdjustment[]
  Company         Company          @relation(fields: [companyId], references: [id])
  SupplierItem    SupplierItem[]
  DebitTransfers  LedgerTransfer[] @relation("TransferDebitSupplier")
  CreditTransfers LedgerTransfer[] @relation("TransferCreditSupplier")
}

model SupplierItem {
  id              String   @id @default(uuid())
  supplierId      String
  itemName        String
  price           Float
  alias           String?
  incomeAccountId String?
  cogsAccountId   String?
  Supplier        Supplier @relation(fields: [supplierId], references: [id])
  IncomeAccount   Account? @relation("IncomeAccount", fields: [incomeAccountId], references: [id])
  CogsAccount     Account? @relation("CogsAccount", fields: [cogsAccountId], references: [id])
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  companyId       String
  createdAt       DateTime         @default(now())
  userName        String
  roleId          String?
  AuditLog        AuditLog[]
  StockAdjustment StockAdjustment[]
  Company         Company          @relation(fields: [companyId], references: [id])
  Role            Role?            @relation(fields: [roleId], references: [id])
  JournalEntries  JournalEntry[]   @relation("JournalPostedBy")
  LedgerTransfers LedgerTransfer[] @relation("TransferPostedBy")
  Expenses        Expense[]        @relation("ExpensePostedBy")
}

// ── Accounting Models ─────────────────────────────────────────────────────────

model Account {
  id              String           @id @default(uuid())
  companyId       String
  code            String
  name            String
  type            AccountType
  normalBalance   NormalBalance
  parentId        String?
  isSystemAccount Boolean          @default(false)
  isActive        Boolean          @default(true)
  description     String?
  createdAt       DateTime         @default(now())
  Company         Company          @relation(fields: [companyId], references: [id])
  Parent          Account?         @relation("AccountParent", fields: [parentId], references: [id])
  Children        Account[]        @relation("AccountParent")
  JournalLines         JournalLine[]
  DebitTransfers       LedgerTransfer[] @relation("TransferDebitAccount")
  CreditTransfers      LedgerTransfer[] @relation("TransferCreditAccount")
  IncomeItems          SupplierItem[]   @relation("IncomeAccount")
  CogsItems            SupplierItem[]   @relation("CogsAccount")
  ExpenseEntries       Expense[]        @relation("ExpenseAccount")
  ExpensePayments      Expense[]        @relation("ExpensePaymentAccount")

  @@unique([companyId, code])
  @@index([companyId])
}

model JournalEntry {
  id                String             @id @default(uuid())
  companyId         String
  entryNumber       String
  date              DateTime
  description       String
  source            JournalSource
  status            JournalEntryStatus @default(POSTED)
  saleId            String?
  customerPaymentId String?
  ledgerTransferId  String?
  invoiceId         String?
  expenseId         String?
  customerReturnId  String?
  reversalOfId      String?
  postedById        String
  createdAt         DateTime           @default(now())
  Company           Company            @relation(fields: [companyId], references: [id])
  PostedBy          User               @relation("JournalPostedBy", fields: [postedById], references: [id])
  Sale              Sale?              @relation(fields: [saleId], references: [id])
  CustomerPayment   CustomerPayment?   @relation(fields: [customerPaymentId], references: [id])
  LedgerTransfer    LedgerTransfer?    @relation("JELedgerTransfer", fields: [ledgerTransferId], references: [id])
  Invoice           Invoice?           @relation(fields: [invoiceId], references: [id])
  Expense           Expense?           @relation(fields: [expenseId], references: [id])
  CustomerReturn    CustomerReturn?    @relation(fields: [customerReturnId], references: [id])
  ReversalOf        JournalEntry?      @relation("JEReversalOf", fields: [reversalOfId], references: [id])
  Reversals         JournalEntry[]     @relation("JEReversalOf")
  lines             JournalLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId])
  @@index([saleId])
  @@index([customerPaymentId])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?
  Account        Account      @relation(fields: [accountId], references: [id])
  JournalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
}

model LedgerTransfer {
  id               String            @id @default(uuid())
  companyId        String
  amount           Float
  description      String
  date             DateTime
  debitPartyType   TransferPartyType
  debitCustomerId  String?
  debitSupplierId  String?
  debitAccountId   String?
  creditPartyType  TransferPartyType
  creditCustomerId String?
  creditSupplierId String?
  creditAccountId  String?
  postedById       String
  createdAt        DateTime          @default(now())
  Company          Company           @relation(fields: [companyId], references: [id])
  PostedBy         User              @relation("TransferPostedBy", fields: [postedById], references: [id])
  DebitCustomer    Customer?         @relation("TransferDebitCustomer", fields: [debitCustomerId], references: [id])
  CreditCustomer   Customer?         @relation("TransferCreditCustomer", fields: [creditCustomerId], references: [id])
  DebitSupplier    Supplier?         @relation("TransferDebitSupplier", fields: [debitSupplierId], references: [id])
  CreditSupplier   Supplier?         @relation("TransferCreditSupplier", fields: [creditSupplierId], references: [id])
  DebitAccount     Account?          @relation("TransferDebitAccount", fields: [debitAccountId], references: [id])
  CreditAccount    Account?          @relation("TransferCreditAccount", fields: [creditAccountId], references: [id])
  JournalEntries   JournalEntry[]    @relation("JELedgerTransfer")

  @@index([companyId])
}

// ── Invoice / Waybill / Expense ───────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid())
  companyId     String
  customerId    String
  saleId        String?
  invoiceNumber String
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  terms         String?
  subtotal      Float
  discountValue Float         @default(0)
  totalAmount   Float
  paidAmount    Float         @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  Company       Company       @relation(fields: [companyId], references: [id])
  Customer      Customer      @relation(fields: [customerId], references: [id])
  Sale          Sale?         @relation(fields: [saleId], references: [id])
  Items         InvoiceItem[]
  JournalEntries JournalEntry[]
  Waybill       Waybill[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([customerId])
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  itemName  String
  quantity  Int
  unitPrice Float
  total     Float
  costPrice Float   @default(0)
  Invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Waybill {
  id            String        @id @default(uuid())
  companyId     String
  customerId    String?
  saleId        String?
  invoiceId     String?
  waybillNumber String
  issueDate     DateTime      @default(now())
  deliveryDate  DateTime?
  deliveredTo   String?
  driverName    String?
  vehicleNo     String?
  notes         String?
  status        WaybillStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  Company       Company       @relation(fields: [companyId], references: [id])
  Customer      Customer?     @relation(fields: [customerId], references: [id])
  Sale          Sale?         @relation(fields: [saleId], references: [id])
  Invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  Items         WaybillItem[]

  @@unique([companyId, waybillNumber])
  @@index([companyId])
}

model WaybillItem {
  id        String  @id @default(uuid())
  waybillId String
  itemName  String
  quantity  Int
  unit      String?
  Waybill   Waybill @relation(fields: [waybillId], references: [id], onDelete: Cascade)
}

model Expense {
  id               String   @id @default(uuid())
  companyId        String
  expenseNumber    String
  date             DateTime
  description      String
  amount           Float
  accountId        String
  paymentAccountId String
  reference        String?
  postedById       String
  createdAt        DateTime @default(now())
  Company          Company  @relation(fields: [companyId], references: [id])
  ExpenseAccount   Account  @relation("ExpenseAccount",        fields: [accountId],        references: [id])
  PaymentAccount   Account  @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id])
  PostedBy         User     @relation("ExpensePostedBy",       fields: [postedById],       references: [id])
  JournalEntries   JournalEntry[]

  @@unique([companyId, expenseNumber])
  @@index([companyId])
}

model CustomerReturn {
  id          String               @id @default(uuid())
  returnNo    String
  customerId  String
  companyId   String
  saleId      String?
  totalAmount Float
  note        String?
  createdAt   DateTime             @default(now())
  Customer    Customer             @relation(fields: [customerId], references: [id])
  Company     Company              @relation(fields: [companyId], references: [id])
  Sale        Sale?                @relation(fields: [saleId], references: [id])
  Items       CustomerReturnItem[]
  JournalEntries JournalEntry[]

  @@unique([companyId, returnNo])
  @@index([companyId])
  @@index([customerId])
}

model CustomerReturnItem {
  id         String         @id @default(uuid())
  returnId   String
  itemName   String
  quantity   Int
  unitPrice  Float
  costPrice  Float          @default(0)
  Return     CustomerReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
}
